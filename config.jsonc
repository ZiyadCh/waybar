{
  "layer": "top",
  "position": "top",
  "height": 10,
  "spacing": 2,
  "exclusive": true,
  "gtk-layer-shell": true,
  "passthrough": false,
  "fixed-center": true,

  "custom/separator": {
    "format": "╏",
    "tooltip": false
  },

  "custom/icon": {
    "format": " ",
    "tooltip": false
  },

  "modules-left": [
    "custom/icon",
    "ext/workspaces",
    "dwl/window",
    "tray"
  ],

  "modules-center": [
    "custom/separator",
    "clock",
    "custom/separator"
  ],

  "modules-right": [
    "cpu",
    "custom/separator",
    "pulseaudio",
    "custom/separator",
    "backlight",
    "custom/separator",
    "network",
    "custom/separator",
    "battery",
    "custom/separator",
    "custom/power"
  ],

  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰂄 {capacity}%",
    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁿"
    ]
  },

  "network": {
    "format-wifi": "󰖩 {essid}",
    "format-ethernet": "󰈀 ETH",
    "format-disconnected": "󰖪 OFF",
    "on-click": "kitty nmtui"
  },

  "backlight": {
    "format": "󰃠 {percent}%",
    "tooltip": true
  },

  "ext/workspaces": {
    "on-click": "activate",
    "format": "{icon}",
    "format-icons": {
      "1": "⚀",
      "2": "⚁",
      "3": "⚂",
      "4": "⚃",
      "5": "⚄",
      "6": "⚅",
      "7": "⚅",
      "8": "⚅",
      "9": "⚅",
    },
    "ignore-hidden": true,
    "sort-by-id": true
  },

  "dwl/window": {
    "format": "{title}",
    "max-length": "20",
"rewrite": {
        "": "Clean",
    }
  },

  "tray": {
    "show-passive-items": true,
    "spacing": 10
  },

"clock": {
    "interval": 60,
    "format": " {:%H:%M}",
    "format-alt": " {:%d/%m/%Y}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
        "mode": "year",
        "mode-mon-col": 3,
        "on-scroll": 1,
        "format": {
            "months": "<span color='#ffead3'><b>{}</b></span>",
            "days": "<span color='#ecc6d9'><b>{}</b></span>",
            "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
            "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
            "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
        }
    }
},

  "cpu": {
    "format": " {usage}%",
    "interval": 1
  },

  "memory": {
    "format": " {used:0.1f}Gb"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " muted",
    "format-icons": {
      "default": ["", "", ""]
    },
    "on-click": "pavucontrol"
  },

  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "wlogout -b 4 &"
  }
}
