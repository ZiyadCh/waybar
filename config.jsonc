{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 0,
  "exclusive": true,
  "gtk-layer-shell": true,
  "passthrough": false,
  "fixed-center": true,
  "modules-left": [
    "custom/icon",
    "custom/icon-arrow",
    "ext/workspaces",
    "custom/workspaces-arrow"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "custom/memory-arrow",
    "memory",
    "custom/audio-arrow",
    "pulseaudio",
    "custom/backlight-arrow",
    "backlight",
    "custom/network-arrow",
    "network",
    "custom/battery-arrow",
    "battery",
    "custom/power-arrow",
    "custom/power"
  ],

  "custom/icon-arrow": {
    "format": "",
    "tooltip": false
  },
  "custom/workspaces-arrow": {
    "format": "",
    "tooltip": false
  },
  "custom/memory-arrow": {
    "format": "",
    "tooltip": false
  },
  "custom/audio-arrow": {
    "format": "",
    "tooltip": false
  },
  "custom/backlight-arrow": {
    "format": "",
    "tooltip": false
  },
  "custom/network-arrow": {
    "format": "",
    "tooltip": false
  },
  "custom/battery-arrow": {
    "format": "",
    "tooltip": false
  },
  "custom/power-arrow": {
    "format": "",
    "tooltip": false
  },
  "custom/icon": {
    "format": " ",
    "tooltip": false
  },
  "ext/workspaces": {
    "on-click": "activate",
    "format": "{icon}",
    "format-icons": {
      "1": "⚀",
      "2": "⚁",
      "3": "⚂",
      "4": "⚃",
      "5": "⚄",
      "6": "⚅",
      "7": "⚅",
      "8": "⚅",
      "9": "⚅"
    },
    "ignore-hidden": true,
    "sort-by-id": true
  },
  "dwl/window": {
    "format": "{title}",
    "max-length": 20,
    "rewrite": {
      "": "Clean",
      "(.*)Gemini(.*)": "Gemini",
      "(.*)chatgpt(.*)": "ChatGPT",
      "(.*)youtube(.*)": "YouTube"
    }
  },
  "tray": {
    "show-passive-items": true,
    "spacing": 10
  },
  "clock": {
    "interval": 1,
    "format": " {:%H:%M:%S}",
    "format-alt": " {:%d/%m/%Y}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
      }
    }
  },
  "cpu": {
    "format": " {usage}%",
    "format-alt": " {used:0.1f}G",
    "on-click": "toggle",
    "interval": 1
  },
  "memory": {
    "format": "  {used:0.1f}GB "
  },
  "pulseaudio": {
    "format": " {icon} {volume}% ",
    "format-muted": "  muted ",
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ],
      "headset": "",
      "headphone": ""
    },
    "on-click": "pavucontrol"
  },
  "backlight": {
    "format": " 󰃠 {percent}% ",
    "tooltip": true
  },
  "network": {
    "format-wifi": " 󰖩 ",
    "format-ethernet": " 󰈀 ETH ",
    "format-disconnected": " 󰖪 OFF ",
    "on-click": "kitty nmtui",
    "tooltip-format": "{essid}"
  },
  "battery": {
    "format": " {icon} {capacity}% ",
    "format-charging": " 󰂄 {capacity}% ",
    "format-plugged": " 󰂄 {capacity}% ",
    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁿"
    ]
  },
  "custom/power": {
    "format": " ⏻ ",
    "tooltip": false,
    "on-click": "wlogout -b 4 &"
  }
}
