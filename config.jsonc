{
  "layer": "top",
  "position": "top",
  "height": 10,
  "spacing": 2,
  "exclusive": true,
  "gtk-layer-shell": true,
  "passthrough": false,
  "fixed-center": true,

  "custom/separator": {
    "format": "/",
    "tooltip": false
  },

  "custom/icon": {
    "format": "☯",
    "tooltip": false
  },

  "modules-left": [
    "custom/icon",
    "ext/workspaces",
    "dwl/window"
  ],

  "modules-center": [
    "custom/separator",
    "clock",
    "custom/separator"
  ],

  "modules-right": [
    "custom/separator",
    "cpu",
    "custom/separator",
    "pulseaudio",
    "custom/separator",
    "backlight",
    "custom/separator",
    "tray",
    "network",
    "custom/separator",
    "battery",
    "custom/separator",
    "custom/power"
  ],

  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰂄 {capacity}%",
    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁿"
    ]
  },

  "network": {
    "format-wifi": "󰖩 {essid}",
    "format-ethernet": "󰈀 ETH",
    "format-disconnected": "󰖪 OFF"
  },

  "backlight": {
    "format": "󰃠 {percent}%",
    "tooltip": true
  },

  "ext/workspaces": {
    "on-click": "activate",
    "format": "{icon}",
    "format-icons": {
      "1": "⚀",
      "2": "⚁",
      "3": "⚂",
      "4": "⚃",
      "5": "⚄",
      "6": "⚅",
      "7": "⚅",
      "8": "⚅",
      "9": "⚅",
    },
    "ignore-hidden": true,
    "sort-by-id": true
  },

  "dwl/window": {
    "format": "{title}"
  },

  "tray": {
    "show-passive-items": true,
    "spacing": 10
  },

  "clock": {
    "tooltip": false,
    "format": " {:%H:%M}"
  },

  "cpu": {
    "format": " {usage}%",
    "interval": 1
  },

  "memory": {
    "format": " {used:0.1f}Gb"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " muted",
    "format-icons": {
      "default": ["", "", ""]
    },
    "on-click": "pavucontrol"
  },

  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "wlogout -p layer-shell &"
  }
}
